NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only. Required only for the seed script and administrative setup tasks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Institutions directory. Optional: point the directory at an external keyed
# API instead of the bundled data/institutions.json. Leave unset to use the
# bundled dataset (no key needed, no database weight).
# INSTITUTIONS_API_URL=https://your-institutions-api.example.com/api/v1
# INSTITUTIONS_API_KEY=your-api-key
